# double-conversion (#32): google/double-conversion, stock.
#
# Upstream vendored it into wpiutil, renamed to wpi/double-conversion/*.h and
# namespace wpi::double_conversion. Only wpiutil's carried json.cpp uses it,
# spelling the namespace double_conversion from inside wpi::util, so it finds
# stock's ::double_conversion as is. The shims keep upstream's header paths and
# namespace working, including in the installed wpiutil headers.

include_guard(GLOBAL)

function(_wpilib_stock_double_conversion)
    # wpiutil is always built, so a missing target means upstream renamed it.
    if(NOT TARGET wpiutil)
        message(FATAL_ERROR "double-conversion.cmake: there's no wpiutil target to wire into")
    endif()

    wpilib_stock_add(
        double-conversion
        GIT_REPOSITORY https://github.com/google/double-conversion.git
        PACKAGE double-conversion
        CMAKE_ARGS -DBUILD_TESTING=OFF
    )

    get_target_property(wpiutil_dir wpiutil SOURCE_DIR)
    wpilib_stock_thirdparty_include(
        "${wpiutil_dir}/src/main/native/thirdparty/double-conversion"
        include
    )
    # One forwarding header per installed stock header.
    set(stock_include "${double-conversion_PREFIX}/include/double-conversion")
    file(GLOB headers RELATIVE "${stock_include}" "${stock_include}/*.h")
    foreach(header IN LISTS headers)
        wpilib_stock_shim(
            "${include}/wpi/double-conversion/${header}"
            "// Generated by .fork/cmake/deps/double-conversion.cmake.
#pragma once
#include <double-conversion/${header}>
namespace wpi {
namespace double_conversion = ::double_conversion;
}  // namespace wpi
"
        )
    endforeach()

    wpilib_stock_wire(wpiutil double-conversion::double-conversion double-conversion)
endfunction()

cmake_language(
    DEFER DIRECTORY "${CMAKE_SOURCE_DIR}"
    CALL _wpilib_stock_double_conversion
)
